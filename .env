NODE_ENV=production
PORT=24674

# Data Al-Qur'an. Bisa URL storage/CDN atau path lokal: ./quran-data.json
QURAN_DATA_URL=https://ttt.kangwifi.eu.org/alquran.json

# securexpress
SECUREXPRESS_PRESET=balanced
SECUREXPRESS_STATS_KEY=ganti_dengan_random_key_panjang
TRUST_PROXY=true
HTTPS_REDIRECT=false
BODY_LIMIT=1mb
REQUEST_LOGGER=false

# Pisahkan domain frontend dengan koma. Kosongkan jika belum perlu CORS lintas domain.
CORS_ORIGINS=https://alquran.kangwifi.eu.org
CORS_CREDENTIALS=false
